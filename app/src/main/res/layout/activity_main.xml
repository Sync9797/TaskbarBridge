<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Redirect home to my launcher" />

        <TextView
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Setup" />

        <Button
            android:id="@+id/pick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Choose my launcher" />

        <Button
            android:id="@+id/home_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Keep One UI Home as default" />

        <Button
            android:id="@+id/a11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Turn on the redirect service" />

        <TextView
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Shizuku (optional)" />

        <Button
            android:id="@+id/shizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Shizuku" />

        <Button
            android:id="@+id/auto_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn on service automatically" />

        <Button
            android:id="@+id/probe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Probe hidden taskbar settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Experiment: native mode"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Makes your launcher the real default home app and forces Samsung's taskbar flags on. Open an app afterwards: if the taskbar is still there, no redirect is needed. If not, tap Restore." />

        <Button
            android:id="@+id/native_try"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Try native mode" />

        <Button
            android:id="@+id/native_restore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restore One UI Home" />

        <TextView
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tuning and diagnostics" />

        <TextView
            android:id="@+id/delay_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/delay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="300" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log One UI window events" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/refresh_log"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Refresh" />

            <Button
                android:id="@+id/copy_log"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Copy" />

            <Button
                android:id="@+id/clear_log"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clear" />
        </LinearLayout>

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
